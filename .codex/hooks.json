{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/detect-gaps.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/validate-commit.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/validate-push.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/session-stop.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/stop-quality-checks.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
